{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 0,
  "exclusive": true,

 "modules-left": ["hyprland/workspaces", "custom/player", "custom/prev", "custom/playpause", "custom/next"],
 "modules-center": ["clock"],
  "modules-right": ["network","bluetooth", "backlight", "pulseaudio", "battery"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },

"custom/player": {
  "exec": "playerctl --player=termusic metadata --format '{{emoji(status)}} {{title}}' 2>/dev/null || echo ''",
  "interval": 2,
  "max-length": 40,
  "escape": true
},

"custom/prev": {
  "format": "󰒮",
  "on-click": "playerctl --player=termusic previous",
  "tooltip": false
},

"custom/playpause": {
  "exec": "playerctl --player=termusic status 2>/dev/null | grep -q Playing && echo 󰏤 || echo 󰐊",
  "on-click": "playerctl --player=termusic play-pause",
  "interval": 2,
  "tooltip": false
},

"custom/next": {
  "format": "󰒭",
  "on-click": "playerctl --player=termusic next",
  "tooltip": false
},

  "clock": {
    "format": "{:%H:%M  󰃭  %d/%m}",
    "format-alt": "{:%A, %d de %B de %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#88c0d0'><b>{}</b></span>",
        "days": "<span color='#e5e9f0'>{}</span>",
        "weekdays": "<span color='#81a1c1'><b>{}</b></span>",
        "today": "<span color='#88c0d0'><b><u>{}</u></b></span>"
      }
    }
  },

  "network": {
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀  eth",
    "format-disconnected": "󰤭  off",
    "format-linked": "󰤫  {ifname}",
    "tooltip-format-wifi": "{essid} — {signalStrength}%\n󰕒 {bandwidthUpBytes}  󰇚 {bandwidthDownBytes}",
    "tooltip-format-ethernet": "{ifname}\n󰕒 {bandwidthUpBytes}  󰇚 {bandwidthDownBytes}",
    "tooltip-format-disconnected": "Sin conexión",
    "on-click": "nm-connection-editor",
    "interval": 5
  },

  "bluetooth": {
    "format": "󰂯  {status}",
    "format-connected": "󰂱  {device_alias}",
    "format-connected-battery": "󰂱  {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\n{num_connections} conectado(s)",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} conectado(s)\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": ["󰌶", "󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  mute",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphone": "󰋋",
      "headset": "󰋎"
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "tooltip-format": "{desc} — {volume}%"
  },

  "battery": {
    "interval": 30,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo} — {power:.1f}W"
  }
}
